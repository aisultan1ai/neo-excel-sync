# Токен от BotFather
BOT_TOKEN=

# Значение заголовка auth-token для Unity REST API
AUTH_TOKEN=

# ID счёта (опционально). Если пусто — фильтр по accountId не применяется.
ACCOUNT_ID=

# ID валюты ревалюации для запроса позиций (по умолчанию 1 = USD в Unity).
CURRENCY_ID=1

# Whitelist Telegram user_id через запятую (например: 12345678,87654321).
# Пустое значение = доступа нет ни у кого, кроме команды /myid.
# Свой ID узнать можно, написав боту /myid.
ALLOWED_USER_IDS=

# --- strategy_predict (предиктивный модуль) ---
# ID счёта алго-фонда, историю которого собираем и предсказываем (#51023 в задаче).
# Используется командой /sync. Без него /predict работать не будет.
ALGO_ACCOUNT_ID=

# Включить опциональный FLOT-контекст-признак (risk-on/off флаг алго).
# По умолчанию 0 (выкл). FLOT ВСЕГДА исключён из торгуемой/предсказываемой вселенной.
INCLUDE_FLOT_CONTEXT=0

# Явный override вселенной тикеров (comma-separated).
# Если пусто — вселенная автоматически = уникальные тикеры из trades (после /sync).
# Если и trades пусты — fallback на 23 ETF из промта (без FLOT).
# Пример: PREDICT_UNIVERSE=XLK,XLE,SPY,QQQ,GLD
PREDICT_UNIVERSE=

# Chat ID (личка админа), куда scheduler будет слать краткие отчёты о daily/weekly jobs.
# Пусто = не слать (только в логи docker compose logs).
# Свой chat_id = свой Telegram user_id (см. /myid).
SCHEDULER_ADMIN_CHAT_ID=

# --- ML версии (shadow-deployment) ---
# Основная ML-модель — та, которую видит пользователь через /predict_ml.
# По умолчанию xgb-1.0. Для cutover на v2 после успешного shadow — сменить на xgb-2.0.
ML_MODEL_VERSION=xgb-1.0

# Shadow-версии — обучаются и пишут прогнозы в БД параллельно с основной,
# но пользователю не показываются. Comma-separated. По умолчанию xgb-2.0.
# Пусто = shadow отключён, тренируется/предиктится только основная.
ML_SHADOW_VERSIONS=xgb-2.0

# Включить Optuna hyperparam-tuning в /train_ml (30 trials × TS-CV, лимит 5 мин на модель).
# По умолчанию 0 (используются default params — быстро). При 1 — качество выше, но /train_ml
# может занимать 5-20 минут в зависимости от объёма данных.
ML_TUNE_HYPERPARAMS=0
