# Токен от BotFather
BOT_TOKEN=

# Значение заголовка auth-token для Unity REST API
AUTH_TOKEN=

# ID счёта (опционально). Если пусто — фильтр по accountId не применяется.
ACCOUNT_ID=

# ID валюты ревалюации для запроса позиций (по умолчанию 1 = USD в Unity).
CURRENCY_ID=1

# Whitelist Telegram user_id через запятую (например: 12345678,87654321).
# Пустое значение = доступа нет ни у кого, кроме команды /myid.
# Свой ID узнать можно, написав боту /myid.
ALLOWED_USER_IDS=
